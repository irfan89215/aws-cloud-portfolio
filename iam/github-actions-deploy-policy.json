{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "SyncSiteFiles",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:DeleteObject"],
      "Resource": "arn:aws:s3:::irfan-portfolio-site-mumbai-2026/*"
    },
    {
      "Sid": "ListBucket",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::irfan-portfolio-site-mumbai-2026"
    },
    {
      "Sid": "ClearCache",
      "Effect": "Allow",
      "Action": "cloudfront:CreateInvalidation",
      "Resource": "arn:aws:cloudfront::<ACCOUNT_ID>:distribution/E9UPKBP1DJTAL"
    }
  ]
}
